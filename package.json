{
  "name": "frontmatter-js",
  "version": "2.0.0",
  "description": "a very simple frontmatter parser",
  "type": "module",
  "main": "./dist/frontmatter.js",
  "types": "./dist/frontmatter.d.ts",
  "exports": {
    ".": {
      "types": "./dist/frontmatter.d.ts",
      "import": "./dist/frontmatter.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='src/**/*.test.ts' 'src/**/*.test.ts'",
    "typecheck": "tsc",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dry": "npm publish . --dry-run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "preversion": "npm run typecheck && npm test",
    "postversion": "git push && git push --tags"
  },
  "author": "worc <curtis.s.mcallister@gmail.com>",
  "homepage": "https://github.com/worc/frontmatter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worc/frontmatter.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
